{
    "ai": {
        "providers": [
            {
                "api_key": "YOUR_API_KEY",
                "model": "deepseek-chat",
                "base_url": "https://api.deepseek.com/v1",
                "multimodal": false
            }
        ],
        "concurrency": 5,
        "max_retries": 3,
        "retry_delay": 1
    },
    "vault": {
        "path": "./knowledge-base",
        "categories": {
        }
    },
    "import": {
        "archive_dir": "_archive",
        "failed_dir": "_failed",
        "dedup": true,
        "dedup_index": ".notemind_index.json",
        "split_threshold_sections": 5,
        "split_threshold_chars": 50000
    },
    "performance": {
        "chunk_size": 5,
        "report_enabled": true
    },
    "logging": {
        "level": "INFO",
        "file": "logs/import.log",
        "log_dir": "logs"
    }
}
